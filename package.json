{
  "name": "lucian-ai-chat-exporter",
  "version": "1.1.0",
  "private": true,
  "description": "Lucian AI Chat Exporter — one-click AI chat handoff and full-fidelity export for ChatGPT, Claude, Gemini and Grok.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/build.mjs && vitest run --config vitest.e2e.config.ts",
    "bench": "node scripts/bench.mjs",
    "package": "node scripts/build.mjs && node scripts/package.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "e2e:install-chrome": "npx @puppeteer/browsers install chrome@stable --path ~/.cache/lucian-cft"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "docx": "^9.11.0",
    "fflate": "^0.8.3",
    "katex": "^0.19.0",
    "marked": "^18.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@puppeteer/browsers": "^3.2.5",
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.3",
    "puppeteer-core": "^25.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
